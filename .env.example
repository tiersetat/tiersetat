# Copier ce fichier en .env.local puis remplir les valeurs.
# Les variables NEXT_PUBLIC_* sont visibles dans le navigateur : jamais de secret dedans.

# --- Solana (DEVNET uniquement : un RPC "mainnet" est refusé au démarrage) ---
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# --- Meteora DBC (étape 2) ---
# Adresse PUBLIQUE du wallet trésorerie : reçoit les partner fees (jamais de clé privée ici)
NEXT_PUBLIC_TREASURY_WALLET=
# Adresse de la config DBC, affichée par /admin après sa création
NEXT_PUBLIC_DBC_CONFIG=
# Anciennes configs (séparées par des virgules) : leurs tokens restent échangeables
NEXT_PUBLIC_DBC_LEGACY_CONFIGS=

# --- Supabase (Project Settings > API Keys) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# Clé "publishable" (sb_publishable_...) ou ancienne clé "anon" : lecture publique filtrée par RLS
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clé "secret" (sb_secret_...) ou ancienne "service_role" : SERVEUR UNIQUEMENT
SUPABASE_SECRET_KEY=

# --- Session (cookie signé). Générer avec : openssl rand -base64 32 ---
SESSION_SECRET=

# --- IPFS / Pinata (étape 3) — secrets serveur uniquement ---
PINATA_JWT=
PINATA_GATEWAY=

# --- Connexion par e-mail / Google / Apple (Privy) — identifiant PUBLIC, facultatif ---
NEXT_PUBLIC_PRIVY_APP_ID=
